{
  "id": "/RHW/",
  "name": "Resolution Heavy Works Command",
  "short_name": "RHW Command",
  "description": "Resolution Heavy Works logistics, production, communications and shipyard command app.",
  "start_url": "./#command/inventory",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0C0C0B",
  "theme_color": "#0C0C0B",
  "orientation": "any",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "./manifest.webmanifest",
      "id": "https://phytehq.github.io/RHW/"
    }
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/pwa-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Command Inventory",
      "short_name": "Inventory",
      "url": "./#command/inventory"
    },
    {
      "name": "Operations Calculator",
      "short_name": "Calculator",
      "url": "./#operations/calculator"
    },
    {
      "name": "Forum Composer",
      "short_name": "Forum",
      "url": "./#comms/forum"
    }
  ]
}
